{
  "name": "@md-code/utils-uniqueness",
  "version": "0.1.0",
  "description": "ESLint rule + CLI that finds duplicate utility functions: same TypeScript signature or same body logic, scattered across the codebase instead of living in one shared module.",
  "license": "MIT",
  "main": "index.js",
  "bin": {
    "md-code-utils-uniqueness": "bin/utils-uniqueness.js"
  },
  "files": [
    "index.js",
    "plugin.js",
    "main.js",
    "config.js",
    "thresholds.js",
    "signature.js",
    "ast.js",
    "jscpd.js",
    "matcher",
    "filter",
    "debt.js",
    "report.js",
    "utils.js",
    "bin",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./plugin": "./index.js"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "jscpd": "^5.4.0",
    "minimatch": "^9.0.4",
    "remeda": "^2.50.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "eslint-rule",
    "duplicate-functions",
    "code-duplication",
    "refactoring",
    "typescript"
  ]
}
