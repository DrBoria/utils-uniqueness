{
  "name": "@md-code/utils-uniqueness",
  "version": "0.1.1",
  "description": "ESLint rule and CLI that find duplicate utility functions by comparing signature, structure, AST and control flow against a canonical utils folder.",
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "duplicate-functions",
    "code-duplication",
    "design-system",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "bin": {
    "md-code-utils-uniqueness": "bin/utils-uniqueness.js"
  },
  "files": [
    "index.js",
    "plugin.js",
    "config.js",
    "main.js",
    "logger.js",
    "utils.js",
    "decision-maker.js",
    "report.js",
    "normalize/",
    "matcher/",
    "filter/",
    "playgrounds/",
    "bin/",
    "README.md",
    "self-catalog.js",
    "lib-registry.js"
  ],
  "exports": {
    ".": "./index.js",
    "./plugin": "./index.js",
    "./config": "./config.js",
    "./report": "./report.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "minimatch": "^9.0.4",
    "remeda": "^2.50.0",
    "ts-morph": "^24.0.0"
  },
  "scripts": {
    "gen:catalog": "node main.js",
    "test": "vitest run"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "devDependencies": {
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
