{
  "name": "@md-code/utils-uniqueness",
  "version": "0.15.1",
  "description": "ESLint rule and CLI that find duplicate utility functions by comparing signature, structure, AST and control flow against a canonical utils folder.",
  "license": "Apache-2.0",
  "author": "DrBoria <dr.boria@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrBoria/utils-uniqueness.git"
  },
  "bugs": {
    "url": "https://github.com/DrBoria/utils-uniqueness/issues"
  },
  "homepage": "https://github.com/DrBoria/utils-uniqueness#readme",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "duplicate-functions",
    "code-duplication",
    "design-system",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "md-code-utils-uniqueness": "dist/main.js"
  },
  "files": [
    "dist/",
    "report/user-report/src/",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./plugin": "./dist/index.js",
    "./config": "./dist/config.js",
    "./report": "./dist/report.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@md-code/code-diff": "file:../code-diff",
    "esbuild": "^0.28.2",
    "minimatch": "^9.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remeda": "^2.50.0",
    "styled-components": "^6.6.0",
    "ts-morph": "^24.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:catalog": "node dist/main.js",
    "overview": "node dist/main.js --overview",
    "report": "node dist/main.js --report",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prismjs": "^1.30.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
